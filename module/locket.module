#!name=Locket Gold by Thanh Lê
#!desc=Gold
#!author=Thanh Lê
#!homepage=https://github.com/thanhlh05/locketgoldthanhle

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold-thanhle/main/scripts/locket.js, requires-body=true, max-size=-1, timeout=120
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/thanhlh05/locket-gold-thanhle/main/scripts/delheader.js, timeout=120

[MITM]
hostname = %APPEND% api.revenuecat.com